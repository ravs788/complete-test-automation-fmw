<Project>
  <!--
    Central package management: every NuGet version lives here.
    Projects reference packages with <PackageReference Include="..." /> (no Version).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Test platform">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <!--
    xUnit v2 on purpose: Allure.Xunit (2.15) doesn't support xUnit v3 yet.
    xunit.runner.visualstudio must stay on 2.x: 3.x/4.x are built on the v3 runner and can't
    load Allure's (v2) runner reporter, so no Allure results are written. Don't bump it.
  -->
  <ItemGroup Label="xUnit + Allure">
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Allure.Xunit" Version="2.15.0" />
    <PackageVersion Include="Allure.Net.Commons" Version="2.15.0" />
  </ItemGroup>

  <ItemGroup Label="Browser and device automation">
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <!-- Selenium is only here because Appium.WebDriver (Tests/UI/Mobile) is built on it. -->
    <PackageVersion Include="Selenium.WebDriver" Version="4.35.0" />
    <PackageVersion Include="Selenium.Support" Version="4.35.0" />
    <PackageVersion Include="DotNetSeleniumExtras.WaitHelpers" Version="3.11.0" />
    <PackageVersion Include="Appium.WebDriver" Version="8.0.0" />
  </ItemGroup>


  <ItemGroup Label="Logging">
    <PackageVersion Include="Elastic.Clients.Elasticsearch" Version="8.12.0" />
  </ItemGroup>
</Project>
