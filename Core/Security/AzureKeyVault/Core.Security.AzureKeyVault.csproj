<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Optional add-on (R36): resolves secret://NAME placeholders from Azure Key Vault. Kept out of Core so only
    projects that use a vault take the Azure packages.
  -->
  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core.csproj" />
  </ItemGroup>

</Project>
