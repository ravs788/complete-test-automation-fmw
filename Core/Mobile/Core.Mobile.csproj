<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Appium adapter (R38, R47): settings + provider, driver factory/options, gestures, and the "appium" UI driver
    (AppiumUiPlugin) that puts mobile sessions on the framework's UI contract. Kept out of Core so Core consumers
    don't depend on Appium/Selenium. No page objects or tests here: suites share the page objects in Pages/.
  -->
  <ItemGroup>
    <PackageReference Include="Appium.WebDriver" />
    <PackageReference Include="Selenium.WebDriver" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.csproj" />
    <!-- Appium speaks W3C WebDriver, so the Appium UI driver reuses the WebDriver session from the Selenium adapter (R47). -->
    <ProjectReference Include="..\Ui\Selenium\Core.Ui.Selenium.csproj" />
  </ItemGroup>

</Project>
