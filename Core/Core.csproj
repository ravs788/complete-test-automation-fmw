<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The add-ons are separate projects inside this folder, so only the suites that need Appium, a vault, a
      broker client, Elasticsearch or Allure take those packages. Don't compile them here (same pattern as Tests/Tests.csproj).
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Mobile/**;Messaging/Kafka/**;Messaging/RabbitMq/**;Security/AzureKeyVault/**;Logging/Elastic/**;Reporting/Allure/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>

</Project>
